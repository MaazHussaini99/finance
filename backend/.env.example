# Teller Certificate Authentication
# Place your certificate.pem and private_key.pem in backend/certs/
TELLER_CERT_PATH=./certs/certificate.pem
TELLER_KEY_PATH=./certs/private_key.pem

# Teller Application ID
# Get this from: https://teller.io/dashboard -> Application section
TELLER_APPLICATION_ID=your_application_id_here

# Set to 'development' for real bank data (not billed, 100 enrollment limit - recommended for personal use)
# Set to 'production' for real bank data (billed)
# Set to 'sandbox' for testing with fake data
TELLER_ENV=development

# Server Configuration
PORT=3001
NODE_ENV=development
